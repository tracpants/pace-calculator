{
  "name": "pace-calculator",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest",
    "test:run": "vitest run",
    "test:e2e": "playwright test tests/e2e/essential-flows.spec.js",
    "test:all": "npm run test:run && npm run test:e2e",
    "lint": "eslint src/ tests/ --ext .js && stylelint \"src/**/*.css\"",
    "lint:fix": "eslint src/ tests/ --ext .js --fix && stylelint \"src/**/*.css\" --fix",
    "validate:tokens": "node scripts/validate-tokens.js",
    "validate:all": "npm run lint && npm run validate:tokens",
    "prepare": "husky",
    "clean": "rm -rf dist coverage test-results playwright-report",
    "reset": "npm run clean && rm -rf node_modules package-lock.json && npm install",
    "audit:security": "npm audit --audit-level=moderate",
    "audit:fix": "npm audit fix",
    "outdated": "npm outdated",
    "ci": "npm ci && npm run validate:all && npm run test:run && npm run build"
  },
  "lint-staged": {
    "*.js": [
      "eslint --fix"
    ],
    "*.css": [
      "stylelint --fix"
    ]
  },
  "devDependencies": {
    "@eslint/js": "^9.37.0",
    "@playwright/test": "^1.55.1",
    "@tailwindcss/postcss": "^4.1.13",
    "@testing-library/dom": "^10.4.0",
    "@testing-library/user-event": "^14.6.1",
    "@vitest/ui": "^3.2.4",
    "autoprefixer": "^10.4.21",
    "eslint": "^9.37.0",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-jsdoc": "^60.8.2",
    "husky": "^9.1.7",
    "jsdom": "^27.0.0",
    "lint-staged": "^16.2.3",
    "postcss": "^8.5.6",
    "stylelint": "^16.25.0",
    "stylelint-config-standard": "^39.0.0",
    "stylelint-order": "^7.0.0",
    "tailwindcss": "^4.1.13",
    "vite": "^7.1.7",
    "vitest": "^3.2.4"
  }
}
