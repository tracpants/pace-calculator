{
  "name": "pace-calculator",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "predev": "node -e \"try { require.resolve('dompurify'); require.resolve('vite') } catch(e) { console.error('\\n❌ Missing dependencies! Run: npm install\\n'); process.exit(1) }\"",
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test tests/e2e/essential-flows.spec.js",
    "test:all": "npm run test:run && npm run test:e2e",
    "badges": "npm run test:coverage && npx generateBadges && node scripts/update-readme-badge.js",
    "badges:generate": "npx generateBadges -o badges && node scripts/update-readme-badge.js",
    "lint": "eslint src/ tests/ --ext .js && stylelint \"src/**/*.css\"",
    "lint:fix": "eslint src/ tests/ --ext .js --fix && stylelint \"src/**/*.css\" --fix",
    "validate:tokens": "node scripts/validate-tokens.js",
    "validate:all": "npm run lint && npm run validate:tokens",
    "prepare": "husky",
    "clean": "rm -rf dist coverage test-results playwright-report test-results.json",
    "reset": "npm run clean && rm -rf node_modules package-lock.json && npm install",
    "audit:security": "npm audit --audit-level=moderate",
    "audit:fix": "npm audit fix",
    "outdated": "npm outdated",
    "ci": "npm ci && npm run validate:all && npm run test:run && npm run build"
  },
  "lint-staged": {
    "*.js": [
      "eslint --fix"
    ],
    "*.css": [
      "stylelint --fix"
    ]
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@playwright/test": "^1.57.0",
    "@tailwindcss/postcss": "^4.1.18",
    "@testing-library/dom": "^10.4.0",
    "@testing-library/user-event": "^14.6.1",
    "@vitest/coverage-v8": "^4.0.15",
    "@vitest/ui": "^4.0.10",
    "autoprefixer": "^10.4.22",
    "eslint": "^9.39.1",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-jsdoc": "^61.5.0",
    "husky": "^9.1.7",
    "jsdom": "^27.2.0",
    "lint-staged": "^16.2.7",
    "node-coverage-badges": "^1.5.2",
    "postcss": "^8.5.6",
    "stylelint": "^16.26.1",
    "stylelint-config-standard": "^39.0.1",
    "stylelint-order": "^7.0.0",
    "tailwindcss": "^4.1.17",
    "vite": "^7.2.7",
    "vitest": "^4.0.10"
  },
  "dependencies": {
    "canvas-confetti": "^1.9.4",
    "dompurify": "^3.3.1",
    "lucide": "^0.556.0",
    "notyf": "^3.10.0"
  }
}
